# Copy to apps/api/.env for local development. Never commit the real .env.

# Resend API key — https://resend.com/api-keys
# If unset, the contact route validates + logs but does not send email.
RESEND_API_KEY=

# Where contact messages are delivered. Defaults to SITE.email from @rhico/shared.
CONTACT_TO_EMAIL=

# Verified sender. Until a domain is verified in Resend, use onboarding@resend.dev.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Local API port (Vite proxy target).
PORT=8787
